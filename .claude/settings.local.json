{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx -y firebase-tools deploy --only hosting)",
      "Bash(node --input-type=module -e ' *)",
      "Bash(npx oxlint *)",
      "Bash(curl -s \"https://firestore.googleapis.com/v1/projects/elnisong-413c2/databases/\\(default\\)/documents/datos/productos\")",
      "Bash(python -c ' *)",
      "Bash(xxd)",
      "Bash(PYTHONIOENCODING=utf-8 python -c ' *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(python -c \"import PIL; from PIL import Image; print\\('Pillow', PIL.__version__\\)\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code} %{size_download} %{content_type}\\\\n\" http://localhost:5188/productos/pan-de-jamon.webp)",
      "Bash(curl -s -o /dev/null -w \"%{http_code} %{size_download}\\\\n\" http://localhost:5188/productos/empanadita-carne.webp)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Usuario/AppData/Local/Programs/Python/Python314/Scripts/headroom.EXE wrap selfheal --marker headroom-wrap-selfheal",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

rules_version = '2';

// Se pega en: Consola de Firebase > Firestore Database > Reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo estos correos pueden entrar. Quien no esté aquí no ve nada, aunque
    // tenga cuenta: crear el usuario no basta, hay que añadirlo a esta lista.
    function autorizado() {
      return request.auth != null
        && request.auth.token.email in [
          'elnisong@gmail.com',
          'donpepesabor@gmail.com'
        ];
    }

    // La página pública solo necesita leer el catálogo.
    match /datos/productos {
      allow read: if true;
      allow write: if autorizado();
    }

    /**
     * Agenda de huecos de reparto, para que la tienda sepa qué franjas están
     * llenas. Solo contiene fechas y cuántos repartos hay en cada franja:
     * ningún nombre, teléfono, dirección ni importe. Los pedidos en sí siguen
     * siendo privados, y eso no cambia.
     */
    match /datos/agenda {
      allow read: if true;
      allow write: if autorizado();
    }

    /**
     * Ajustes que la tienda necesita saber antes de enseñarse, hoy solo uno:
     * si está cerrada por mantenimiento y con qué mensaje.
     *
     * Lectura pública porque lo tiene que leer un cliente sin cuenta, y no hay
     * nada privado dentro. Escribir, solo la gestión: y además, al otro lado
     * del botón se pide la contraseña otra vez, que cerrar la tienda no es
     * algo que deba pasar por tocar sin querer.
     */
    match /datos/ajustes {
      allow read: if true;
      allow write: if autorizado();
    }

    /**
     * Direcciones ya buscadas en el mapa: el punto y los kilómetros, para no
     * volver a preguntárselo a nadie. Ver "LAS DIRECCIONES QUE YA SE SABEN" en
     * src/tienda/envio.js.
     *
     * El nombre de cada ficha es una HUELLA de la dirección, no la dirección:
     * solo da con ella quien ya sabe la calle, el número y el código postal
     * exactos. Y además:
     *
     * - `get` sí, `list` no. Se puede consultar UNA ficha concreta; pedir la
     *   lista entera, no. Sin eso, la lectura pública sería un listado de dónde
     *   viven los clientes, y eso no puede ser.
     * - La tienda puede CREAR fichas nuevas, pero no cambiar las que ya están.
     *   Una dirección bien situada no la puede estropear nadie desde fuera;
     *   corregirla, solo la gestión.
     * - Los topes dejan fuera cualquier cosa que no sea un punto de Madrid y su
     *   provincia, para que esto no sirva de almacén de nada más.
     */
    match /distancias/{clave} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['lat', 'lon', 'km', 'estado', 'fecha'])
        && request.resource.data.keys().hasAll(['lat', 'lon', 'estado', 'fecha'])
        && request.resource.data.lat is number
        && request.resource.data.lat > 39.4 && request.resource.data.lat < 41.3
        && request.resource.data.lon is number
        && request.resource.data.lon > -4.9 && request.resource.data.lon < -2.6
        && request.resource.data.estado in ['ok', 'aproximado']
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() == 10
        && (!('km' in request.resource.data) ||
            (request.resource.data.km is number
             && request.resource.data.km >= 0
             && request.resource.data.km <= 200));
      allow list, update, delete: if autorizado();
    }

    /**
     * Bandeja de entrada de los pedidos hechos en la tienda.
     *
     * Cualquiera puede DEJAR un pedido (la tienda es pública y el cliente no tiene
     * cuenta), pero nadie de fuera puede leer los de los demás, cambiarlos ni
     * borrarlos: eso solo la gestión. Por eso los pedidos de la web no entran
     * directos en la lista, sino que el dueño los acepta uno a uno.
     *
     * Los topes son para que un gracioso no llene la base de datos: un pedido
     * razonable no pasa de 40 líneas ni de un nombre de 80 letras.
     */
    match /pedidosWeb/{pedido} {
      allow create: if request.resource.data.keys().hasAll(['nombre', 'telefono', 'items'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() <= 30
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 40;
      allow read, update, delete: if autorizado();
    }

    // Todo lo demás: solo con sesión autorizada.
    match /{document=**} {
      allow read, write: if autorizado();
    }
  }
}
